# Event Cloud Manager - Firebase Web SDK Client Configuration
# (Safe for public client-side bundling - DO NOT put private service account keys here!)

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Local Emulator Integration Flag (true/false)
VITE_USE_FIREBASE_EMULATOR=false

# College Domain & Customization Settings
VITE_COLLEGE_NAME="Apex Institute of Technology"
VITE_COLLEGE_EMAIL_DOMAIN="apex.edu.in"
VITE_QR_TOKEN_EXPIRY_SECONDS=60
