rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }
    
    function isCoordinator() {
      return isAdmin() || hasRole('coordinator');
    }
    
    function isAssignedCoordinator(eventId) {
      return isAdmin() || (
        isCoordinator() && 
        exists(/databases/$(database)/documents/events/$(eventId)) && 
        request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.coordinatorUids
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // --- Users Collection ---
    match /users/{userId} {
      // Anyone authenticated can read user profile data (e.g. coordinator views student names)
      allow read: if isAuthenticated();
      
      // On creation, a user cannot grant themselves 'admin' or 'coordinator' role unless caller is admin
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'student') ||
        isAdmin()
      );
      
      // Students can only update allowed profile fields (not role, not rollNumber, not accountStatus)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        (!('rollNumber' in resource.data) || request.resource.data.rollNumber == resource.data.rollNumber) &&
        (!('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus)
      );
      
      allow delete: if isAdmin();
    }
    
    // --- Events Collection ---
    match /events/{eventId} {
      // Public can read published/ongoing/completed events; authenticated users can read all active events
      allow read: if resource.data.status in ['published', 'ongoing', 'completed'] || isAuthenticated();
      
      allow create: if isAdmin() || isCoordinator();
      
      allow update: if isAdmin() || (
        isCoordinator() && 
        request.auth.uid in resource.data.coordinatorUids
      );
      
      allow delete: if isAdmin();
    }
    
    // --- Registrations Collection ---
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isCoordinator() || 
        resource.data.studentUid == request.auth.uid
      );
      
      // A student can only register themselves, cannot forge registeredAt or change others' records
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.studentUid == request.auth.uid
      );
      
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.studentUid == request.auth.uid
      );
    }
    
    // --- Attendance Sessions Collection ---
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      
      allow create: if isAdmin() || (
        isCoordinator() && 
        request.auth.uid in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.coordinatorUids
      );
      
      allow update: if isAdmin() || (
        isCoordinator() && 
        request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.coordinatorUids
      );
      
      allow delete: if isAdmin();
    }
    
    // --- Attendance Records Collection ---
    match /attendanceRecords/{recordId} {
      // Students can read ONLY their own records. Admins and coordinators can view event attendance.
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isCoordinator() || 
        resource.data.studentUid == request.auth.uid
      );
      
      // Crucial Security Rule: Students cannot directly create or modify verified attendance records.
      // Records must be written by Cloud Functions or authorized Coordinators/Admins.
      allow create, update: if isAdmin() || isCoordinator();
      
      allow delete: if isAdmin();
    }
    
    // --- Audit Logs Collection ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Server-side admin SDK bypasses rules
    }
  }
}
